{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "segment",
  "version": 3,
  "name": "Segment",
  "provider": "Twilio Inc.",
  "category": "statistics",
  "purpose": "Collects visit data for the site's other tools.",
  "privacyUrl": "https://www.twilio.com/en-us/legal/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "cdn.segment.com",
      "segment.io",
      "segmentapis.com"
    ],
    "inline": [
      "cdn.segment.com/analytics.js"
    ]
  },
  "cookies": [
    {
      "name": "ajs_anonymous_id",
      "lifetime": "1 year",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "ajs_user_id",
      "lifetime": "1 year",
      "purpose": "Stores the signed-in user."
    },
    {
      "name": "ajs_group_id",
      "lifetime": "1 year",
      "purpose": "Stores the group the visitor belongs to."
    }
  ],
  "storage": [
    "ajs_user_traits",
    "ajs_group_properties"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://www.twilio.com/en-us/legal/privacy",
    "https://www.twilio.com/docs/segment/connections/sources/catalog/libraries/website/javascript/",
    "https://www.twilio.com/docs/segment/connections/sources/catalog/libraries/website/javascript/quickstart/",
    "https://www.twilio.com/docs/segment/guides/regional-segment/",
    "https://dataprivacyframework.gov/list",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-28"
}
