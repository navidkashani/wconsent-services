{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "myfonts",
  "version": 1,
  "name": "MyFonts",
  "provider": "Monotype Imaging Holdings Inc.",
  "category": "functional",
  "purpose": "Loads licensed fonts and counts page views.",
  "privacyUrl": "https://www.monotype.com/legal/privacy-policy/web-font-tracking-privacy-policy",
  "dataCountry": "USA",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "hello.myfonts.net",
      "cdn.fonts.net"
    ]
  },
  "cookies": [],
  "storage": [],
