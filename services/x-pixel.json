{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "x-pixel",
  "version": 1,
  "name": "X (Twitter) Pixel",
  "provider": "X Internet Unlimited Company",
  "category": "marketing",
  "purpose": "Measures X (Twitter) ads.",
  "privacyUrl": "https://x.com/en/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "ads-twitter.com",
      "analytics.twitter.com",
      "t.co/i/adsct",
      "t.co/1/i/adsct"
