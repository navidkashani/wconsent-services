    "inline": [
      "twq('config'",
      "twq(\"config\"",
      "twq('init'",
      "twq(\"init\"",
      "static.ads-twitter.com/uwt.js"
    ]
  },
  "cookies": [
    {
      "name": "muc_ads",
      "lifetime": "2 years",
