{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "google-maps",
  "version": 1,
  "name": "Google Maps",
  "provider": "Google Ireland Limited",
  "category": "media",
  "purpose": "Shows embedded maps.",
  "privacyUrl": "https://policies.google.com/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "google.com/maps",
      "maps.google.com",
      "maps.googleapis.com"
    ]
  },
  "cookies": [
    {
      "name": "NID",
      "lifetime": "6 months",
      "purpose": "Remembers preferences.",
      "httpOnly": true
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "map",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://policies.google.com/technologies/cookies",
    "https://policies.google.com/privacy/frameworks",
    "https://policies.google.com/privacy",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-27"
}
