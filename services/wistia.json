{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "wistia",
  "version": 2,
  "name": "Wistia",
  "provider": "Wistia, Inc.",
  "category": "media",
  "purpose": "Shows embedded videos.",
  "privacyUrl": "https://wistia.com/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "wistia.com",
      "wistia.net"
    ]
  },
  "cookies": [
    {
      "name": "_distillery",
      "lifetime": "1 year",
      "purpose": "Resumes a video where you left off."
    },
    {
      "name": "_simplex",
      "lifetime": "1 year",
      "purpose": "Stores referrer and landing page."
    },
    {
      "name": "wistia",
      "lifetime": "Session",
      "purpose": "Needed for the video player to work."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "video",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://wistia.com/privacy",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-27"
}
