    "https://releases.jquery.com/",
    "https://jquery.com/",
    "https://openjsf.org/privacy",
    "https://github.com/jquery/infrastructure-puppet/blob/staging/doc/cdn.md",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-31"
