{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "bunny-fonts",
  "version": 1,
  "name": "Bunny Fonts",
  "provider": "BunnyWay d.o.o.",
  "category": "functional",
  "purpose": "Loads the site's fonts from bunny.net.",
  "privacyUrl": "https://bunny.net/privacy/",
  "dataCountry": "EU (Slovenia), served from a global CDN",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "fonts.bunny.net"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "bunnycdn/bunnycdn.php"
    ],
    "handles": []
  },
  "sources": [
    "https://fonts.bunny.net/about",
    "https://fonts.bunny.net/faq",
    "https://bunny.net/fonts/",
    "https://bunny.net/privacy/",
    "https://bunny.net/gdpr/",
    "https://bunny.net/gdpr/sub-processors/",
    "https://bunny.net/network/",
    "https://wordpress.org/plugins/bunnycdn/",
    "https://plugins.svn.wordpress.org/bunnycdn/tags/3.1.1/"
  ],
  "checked": "2026-10-31"
}
