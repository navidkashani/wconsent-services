{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "soundcloud",
  "version": 1,
  "name": "SoundCloud",
  "provider": "SoundCloud Global Limited & Co. KG",
  "category": "media",
  "purpose": "Plays embedded audio.",
  "privacyUrl": "https://soundcloud.com/pages/privacy",
  "dataCountry": "EU (Germany) and USA",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "w.soundcloud.com"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "audio",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://soundcloud.com/pages/privacy",
    "https://developers.soundcloud.com/docs/api/html5-widget",
    "https://developers.soundcloud.com/docs/api/cookies"
  ],
  "checked": "2026-10-27"
}
