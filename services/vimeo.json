{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "vimeo",
  "version": 2,
  "name": "Vimeo",
  "provider": "Vimeo.com, Inc.",
  "category": "media",
  "purpose": "Shows embedded videos.",
  "privacyUrl": "https://vimeo.com/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "player.vimeo.com"
    ]
  },
  "cookies": [
    {
      "name": "vuid",
      "lifetime": "2 years",
      "purpose": "Video analytics for the video owner."
    },
    {
      "name": "player",
      "lifetime": "1 year",
      "purpose": "Remembers volume, quality and captions."
    },
    {
      "name": "flags",
      "lifetime": "1 year",
      "purpose": "Feature settings the video owner turned on."
    },
    {
      "name": "lc_*",
      "lifetime": "7 days",
      "purpose": "Remembers a submitted video form."
    },
    {
      "name": "player_clearance",
      "lifetime": "7 days",
      "purpose": "Bot prevention."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "video",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://vimeo.com/privacy",
    "https://vimeo.com/legal/privacy/policy",
    "https://help.vimeo.com/hc/en-us/articles/26080940921361-Vimeo-Player-Cookies",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-27"
}
