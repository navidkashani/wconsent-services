{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "google-analytics",
  "version": 3,
  "name": "Google Analytics",
  "provider": "Google Ireland Limited",
  "category": "statistics",
  "purpose": "Measures visits and conversions.",
  "privacyUrl": "https://policies.google.com/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "googletagmanager.com/gtag/js",
      "googletagmanager.com/gtag/js?id=G-",
      "googletagmanager.com/gtag/js?id=UA-",
      "google-analytics.com",
      "analytics.google.com"
    ],
    "inline": [
      "google-analytics.com/analytics.js",
      "gtag('config', 'G-",
      "gtag(\"config\", \"G-",
      "gtag('config','G-",
      "gtag(\"config\",\"G-"
    ]
  },
  "cookies": [
    {
      "name": "_ga",
      "lifetime": "2 years",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "_ga_*",
      "lifetime": "2 years",
      "purpose": "Keeps the session state."
    },
    {
      "name": "_gid",
      "lifetime": "24 hours",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "_gat*",
      "lifetime": "1 minute",
      "purpose": "Limits the request rate."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": true,
    "advanced": true
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "google-site-kit/google-site-kit.php",
      "google-analytics-for-wordpress/googleanalytics.php",
      "google-analytics-dashboard-for-wp/gadwp.php",
      "wp-analytify/wp-analytify.php",
      "ga-google-analytics/ga-google-analytics.php",
      "woocommerce-google-analytics-integration/woocommerce-google-analytics-integration.php",
      "seo-by-rank-math/rank-math.php"
    ],
    "handles": [
      "googlesitekit-events-provider-contact-form-7",
      "googlesitekit-events-provider-content-events",
      "googlesitekit-events-provider-easy-digital-downloads",
      "googlesitekit-events-provider-mailchimp",
      "googlesitekit-events-provider-ninja-forms",
      "googlesitekit-events-provider-optin-monster",
      "googlesitekit-events-provider-popup-maker",
      "googlesitekit-events-provider-woocommerce",
      "googlesitekit-events-provider-wpforms",
      "monsterinsights-frontend-script",
      "exactmetrics-frontend-script",
      "wp-analytify-scrolldepth",
      "wp-analytify-video-tracking",
      "wp-analytify-miscellaneous-tracking",
      "woocommerce-google-analytics-integration"
    ]
  },
  "sources": [
    "https://business.safety.google/adscookies/",
    "https://policies.google.com/technologies/cookies",
    "https://policies.google.com/privacy/frameworks",
    "https://policies.google.com/privacy",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/google-site-kit/trunk/google-site-kit.php",
    "https://plugins.svn.wordpress.org/google-analytics-for-wordpress/trunk/googleanalytics.php",
    "https://plugins.svn.wordpress.org/google-analytics-dashboard-for-wp/trunk/gadwp.php",
    "https://plugins.svn.wordpress.org/wp-analytify/trunk/wp-analytify.php",
    "https://plugins.svn.wordpress.org/ga-google-analytics/trunk/ga-google-analytics.php",
    "https://plugins.svn.wordpress.org/woocommerce-google-analytics-integration/trunk/woocommerce-google-analytics-integration.php",
    "https://plugins.svn.wordpress.org/seo-by-rank-math/trunk/rank-math.php"
  ],
  "checked": "2026-10-31"
}
