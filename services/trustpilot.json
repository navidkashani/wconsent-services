{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "trustpilot",
  "version": 1,
  "name": "Trustpilot",
  "provider": "Trustpilot A/S",
  "category": "media",
  "purpose": "Shows Trustpilot reviews.",
  "privacyUrl": "https://corporate.trustpilot.com/legal/for-reviewers/privacy-policy-end-user/jun-2026",
  "dataCountry": "EU and USA",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "widget.trustpilot.com"
    ]
  },
  "cookies": [],
  "storage": [
    "trustBoxSettings"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "generic",
  "wordpress": {
    "plugins": [
      "trustpilot-reviews/wc_trustpilot.php"
    ],
    "handles": []
  },
  "sources": [
    "https://corporate.trustpilot.com/legal/for-reviewers/privacy-policy-end-user/jun-2026",
    "https://corporate.trustpilot.com/legal/for-everyone/cookie-policy/may-2025",
    "https://corporate.trustpilot.com/legal/for-businesses/subprocessors/may-2026",
    "https://legal.trustpilot.com/for-businesses/update-to-trustpilot-subprocessor-list-faqs",
    "https://help.trustpilot.com/s/article/TrustBox-widgets-FAQ?language=en_US",
    "https://images-static.trustpilot.com/b2b/integrations/how-to-setup-javascript-integration.pdf",
    "https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js",
    "https://widget.trustpilot.com/trustboxes/5419b6a8b0d04a076446a9ad/main.js",
    "https://invitejs.trustpilot.com/tp.min.js",
    "https://simplicity.trustpilot.com/embed",
    "https://wordpress.org/plugins/trustpilot-reviews/",
    "https://plugins.svn.wordpress.org/trustpilot-reviews/trunk/",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-31"
}
