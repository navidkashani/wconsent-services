{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "help-scout",
  "version": 1,
  "name": "Help Scout Beacon",
  "provider": "Help Scout PBC",
  "category": "functional",
  "purpose": "Live chat and help articles.",
  "privacyUrl": "https://www.helpscout.com/company/legal/privacy/",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "beacon-v2.helpscout.net"
    ],
    "inline": [
      "Beacon('init'",
      "Beacon.readyQueue"
    ]
  },
  "cookies": [],
  "storage": [
    "persist:hs-beacon-*",
    "hs-beacon-*"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://docs.helpscout.com/article/1356-add-beacon-to-your-website-or-app",
    "https://docs.helpscout.com/article/815-csp-settings-for-beacon",
    "https://developer.helpscout.com/beacon-2/web/javascript-api/",
    "https://beacon-v2.helpscout.net/",
    "https://www.helpscout.com/company/legal/privacy/",
    "https://www.helpscout.com/company/legal/cookie-policy/",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/help-scout/trunk/"
  ],
  "checked": "2026-10-31"
}
