  "id": "font-awesome",
  "version": 1,
  "name": "Font Awesome",
  "provider": "Fonticons, Inc.",
  "category": "functional",
  "purpose": "Loads the site's icons from Font Awesome.",
  "privacyUrl": "https://fontawesome.com/privacy",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
