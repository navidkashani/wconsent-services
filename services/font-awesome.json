    "https://fontawesome.com/privacy",
    "https://plugins.svn.wordpress.org/font-awesome/trunk/",
    "https://wordpress.org/plugins/font-awesome/",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-10-31"
}
