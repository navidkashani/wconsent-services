{
  "$schema": "https://cdn.jsdelivr.net/gh/navidkashani/wconsent-services@1/schema/service.json",
  "id": "lets-connect",
  "version": 1,
  "name": "Let's Connect",
  "provider": "PATHADVICE International GmbH",
  "category": "functional",
  "purpose": "Live chat and video calls.",
  "privacyUrl": "https://www.letsconnect.at/data-privacy",
  "dataCountry": "",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "app.letsconnect.at",
      "app.vega.company/embed",
      "pathadvice-app-next.web.app"
    ],
    "inline": [
      "app.letsconnect.at/embed.js",
      "app.vega.company/embed.js",
      "pathadvice-app-next.web.app/embed.js"
    ]
  },
  "cookies": [
    {
      "name": "pa_bsid",
      "lifetime": "1 year",
      "purpose": "Recognises the visitor's chat session."
    }
  ],
  "storage": [
    "pa-visitorId",
    "pa-browser-session-id",
    "pa-json",
    "lc-closed-for-session",
    "lc-display-delay-complete:*"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://www.letsconnect.at/",
    "https://www.letsconnect.at/help",
    "https://www.letsconnect.at/data-privacy",
    "https://www.letsconnect.at/terms-of-use",
    "https://app.pathadvice.at/chunk-0dbff094.73b4d580.js",
    "https://app.pathadvice.at/app.73b4d580.js",
    "https://app.letsconnect.at/embed.js",
    "https://app.vega.company/embed.js",
    "https://vega.company/en/b2b/",
    "https://vega.company/en/datenschutz.html"
  ],
  "checked": "2026-10-31"
}
